# ~/.config/woow-tailscale/woow-tailscale.env (mode 0600), created from this file by
# scripts/install.sh on the first run.
#
# Read only by the install/upgrade scripts, which render these values into the unit
# (decision D2). The node's own settings live in the other file,
# ~/.config/woow-tailscale/tailscale.env, which podman reads.
# One KEY=value per line: no quotes, no "export", no comments after a value.

# Where the node's identity lives: machine key, node key, prefs and the serve config.
# %h is expanded by systemd to the home directory of the account running the unit.
# Point this at an existing state directory to adopt a node (scripts/install.sh
# --state-dir DIR writes it for you, and scripts/migrate-legacy.sh derives it from the
# running container). install.sh creates only the default path; any other path must
# exist already, so a typo cannot enrol a brand-new node.
TS_STATE_DIR=%h/.local/share/woow-tailscale/state
