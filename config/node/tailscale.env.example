# ~/.config/woow-tailscale/tailscale.env (mode 0600), created from this file by
# scripts/install.sh on the first run. podman reads it with --env-file, so it must be
# plain KEY=value lines: everything after "=" is the value, including quotes and
# anything that looks like a "# comment". install.sh refuses a file that has them.
# Variable names mirror the Home Assistant add-on's option keys.
#
# TS_USERSPACE_NETWORKING and TS_WEB_LISTEN belong to the unit, not here: the unit
# forces them and podman's --env wins over --env-file.

# Control plane: empty means the official Tailscale service, a URL means self-hosted
# Headscale. Changing it on an enrolled node logs the node out and re-registers it,
# which means a new identity and a new tailnet IP.
TS_LOGIN_SERVER=

# Pre-auth key, needed only for the first login. Clear it once the node is enrolled.
TS_AUTHKEY=

# Node name on the tailnet. install.sh refuses to install while this is woow-node.
TS_HOSTNAME=woow-node

TS_ACCEPT_DNS=true
TS_ACCEPT_ROUTES=true
TS_SNAT_SUBNET_ROUTES=true
TS_STATEFUL_FILTERING=false
# WireGuard port. One node per host per port: a second node needs a different one.
TS_UDP_PORT=41641

# Subnet router, comma separated, for example 192.168.2.0/24
TS_ADVERTISE_ROUTES=
TS_ADVERTISE_EXIT_NODE=false
TS_ADVERTISE_CONNECTOR=false
# Tailnet IP or MagicDNS name of an exit-node peer
TS_EXIT_NODE=
# Comma separated, for example tag:server
TS_TAGS=
TS_ALWAYS_USE_DERP=false

# `tailscale web`, the node's own admin UI: writable and unauthenticated, so the unit
# binds it to 127.0.0.1:8088 and it is off by default. It can log this node out.
TS_WEB_UI=false

TS_EXTRA_UP_ARGS=
TS_EXTRA_TAILSCALED_ARGS=
# trace|debug|info|notice|warning|error|fatal. debug and trace add tailscaled --verbose.
TS_LOG_LEVEL=info
