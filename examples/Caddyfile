# LAN-facing reverse proxy in front of tailscale web UI on :8088.
# - HTTPS on :8443 with Caddy-managed self-signed cert (tls internal).
# - Basic auth (user/hash from env; supplied by compose or quadlet).
# - Only proxies /   → tailscale web UI. Nothing else exposed.

{
	# Auto self-signed CA + cert for LAN use. Trust the CA on your client
	# (Caddy prints its path on first boot: `/data/caddy/pki/authorities/local/root.crt`).
	local_certs
	# ClientHello with SNI=<LAN-IP> would otherwise mismatch and Caddy rejects
	# the handshake. Fall back to the `localhost` cert so `https://<host_ip>:8443`
	# works (browser warns once about hostname mismatch, then you accept).
	default_sni localhost
	# Uncomment for debug:
	# debug
}

# Site block MUST include a hostname so `tls internal` has something to issue
# a cert for. `https://:8443` also catches IP-only requests (matched via default_sni).
localhost:8443, https://:8443 {
	tls internal

	basic_auth {
		# env: BASIC_AUTH_USER, BASIC_AUTH_HASH
		# hash from:  caddy hash-password --plaintext 'your-password'
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy {$TAILSCALE_UPSTREAM} {
		header_up X-Forwarded-Proto https
	}

	# Aggressive security headers for a LAN-only admin UI.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format console
	}
}
