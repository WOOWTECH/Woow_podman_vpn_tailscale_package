# Woow Tailscale: a tailnet node for this host, in the host network namespace with
# userspace networking. This is the rootless primary path, and the only one supported.
#
# scripts/install.sh renders this file (decision D2: the tokens listed in
# quadlet/render-vars get their values from ~/.config/woow-tailscale/woow-tailscale.env)
# and installs the result to ~/.config/containers/systemd/. Edit the env files, not the
# installed copy: the next install overwrites local edits (after keeping a backup copy).
#
# Why host network + userspace: rootless Podman cannot grant NET_ADMIN over the host's
# network namespace, so a kernel-mode tun here only crash-loops. In userspace mode
# tailscaled needs no capabilities and no /dev/net/tun:
#   - inbound tailnet connections to this node land on host loopback
#     (ssh to the tailnet IP reaches 127.0.0.1:22)
#   - `tailscale serve` TCP forwards (kept in the state dir) reach 127.0.0.1:<port>
#   - subnet routes and exit-node still work, through the netstack
#
# The state directory is a bind mount, not a named volume, so an existing node keeps its
# identity: machine key, node key, tailnet IP and serve configuration. Point TS_STATE_DIR
# at the directory the previous deployment used and nothing on the tailnet notices the
# migration.
[Unit]
Description=Woow Tailscale node (host network, userspace)
Documentation=https://github.com/WOOWTECH/Woow_podman_vpn_tailscale_package

[Container]
ContainerName=woow-tailscale

# Built locally by scripts/install.sh from ./Containerfile, whose base is pinned to
# docker.io/tailscale/tailscale:v1.102.3. Tag = <tailscale version>-r<package revision>.
# The image is in no registry, so Pull=never.
Image=localhost/woow-tailscale:1.102.3-r1
Pull=never

Network=host
Volume=@@TS_STATE_DIR@@:/var/lib/tailscale

# The node's TS_* settings, mode 0600. TS_AUTHKEY is only needed for the first login.
# No "-" prefix: Quadlet passes this to --env-file verbatim, and podman rejects the dash.
EnvironmentFile=%h/.config/woow-tailscale/tailscale.env
# Forced by the unit, because podman's --env overrides --env-file:
#  - userspace mode: kernel mode cannot work in the rootless host netns.
#  - loopback-only `tailscale web`: it is a writable admin UI with no authentication at
#    all. Reach it through a tailnet serve forward to 127.0.0.1:8088, or over ssh -L.
Environment=TS_USERSPACE_NETWORKING=true
Environment=TS_WEB_LISTEN=127.0.0.1:8088
Environment=TINI_SUBREAPER=1

HealthCmd=tailscale status --peers=false
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s

Label=io.woowtech.app=woow-tailscale

[Service]
# Never start with a missing state directory: a mistyped path would enrol a fresh node,
# hand out a new tailnet IP and drop every serve forward.
ExecStartPre=/usr/bin/test -d @@TS_STATE_DIR@@
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
