[Unit]
Description=Rootless Nginx Proxy Manager (owned secure deployment)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart="@REPO_ROOT@/scripts/deploy.sh"
# Stop the scheduler before removing the scoped stack. Missing or already
# inactive health units must not fail the main service's stop.
ExecStop=-/usr/bin/systemctl --user stop nginx-proxy-manager-healthcheck.timer nginx-proxy-manager-healthcheck.service
ExecStop="@REPO_ROOT@/scripts/remove.sh"
# Covers deploy plus the nested verification readiness budgets and image pull.
TimeoutStartSec=900
TimeoutStopSec=180
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
