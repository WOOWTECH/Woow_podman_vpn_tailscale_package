# Copy to .env and edit before running `podman-compose up -d` (or `systemctl --user start podman-tailscale`).
# Env-var names mirror the HA add-on's option keys.

# ─── Control plane (leave empty for official Tailscale) ─────────────────────
# Empty  → https://controlplane.tailscale.com (official Tailscale SaaS)
# URL    → self-hosted Headscale, e.g. http://192.168.2.191:28080
TS_LOGIN_SERVER=

# Pre-auth key (Tailscale: `tskey-auth-…`; Headscale: `headscale --user X preauthkeys create`).
# Leave empty for first-run interactive OAuth via URL printed in the log:
#   podman logs woow-tailscale | grep 'To authenticate'
TS_AUTHKEY=

# ─── Node identity ───────────────────────────────────────────────────────────
TS_HOSTNAME=woow-hermes

# ─── Networking ──────────────────────────────────────────────────────────────
TS_ACCEPT_DNS=true
TS_ACCEPT_ROUTES=true
TS_SNAT_SUBNET_ROUTES=true
TS_STATEFUL_FILTERING=false
TS_UDP_PORT=41641
TS_USERSPACE_NETWORKING=false   # true = no NET_ADMIN needed (slower, still supports advertise)

# ─── Subnet router / exit node ───────────────────────────────────────────────
TS_ADVERTISE_ROUTES=            # ex: 192.168.2.0/24,10.0.0.0/24
TS_ADVERTISE_EXIT_NODE=false
TS_ADVERTISE_CONNECTOR=false
TS_EXIT_NODE=                   # tailnet IP or magicdns of an exit-node peer

# ─── Tagging & DERP ──────────────────────────────────────────────────────────
TS_TAGS=                        # ex: tag:server,tag:woow
TS_ALWAYS_USE_DERP=false

# ─── Web UI (opt-in) ─────────────────────────────────────────────────────────
# TS_WEB_UI=true → tailscale web on 0.0.0.0:8088 inside the container.
# The compose file binds this to 127.0.0.1:8088 on the host and Caddy sidecar
# adds basic auth for LAN access (see examples/Caddyfile).
TS_WEB_UI=true
TS_WEB_LISTEN=0.0.0.0:8088

# ─── Reverse-proxy basic auth (compose caddy sidecar) ────────────────────────
BASIC_AUTH_USER=woow
# Generate hash:
#   podman run --rm docker.io/caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=
# Which LAN port Caddy listens on (HTTPS via caddy-managed self-signed).
CADDY_LAN_PORT=8443

# ─── Advanced passthrough ────────────────────────────────────────────────────
TS_EXTRA_UP_ARGS=
TS_EXTRA_TAILSCALED_ARGS=
TS_LOG_LEVEL=info
