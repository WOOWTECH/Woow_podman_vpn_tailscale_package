# Generated by woow-tailscale-gateway; do not edit.
[Unit]
Description=Woow Tailscale Headscale service gateway
After=network-online.target
Wants=network-online.target

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
ExecStartPre=@CHECKOUT@/scripts/resource_ownership.py reconcile-container @CHECKOUT@
ExecStartPre=@CHECKOUT@/scripts/resource_ownership.py check-volume @CHECKOUT@
ExecStart=/usr/bin/podman run --name=woow-tailscale-gateway --network=host --env-file=%h/.config/woow-tailscale-gateway/gateway.env --volume=woow-tailscale-gateway-state:/var/lib/tailscale --label=org.woow-tailscale.project=woow-tailscale-gateway --label=org.woow-tailscale.role=gateway --label=org.woow-tailscale.managed-by=woow-gateway-lifecycle --label=org.woow-tailscale.checkout=@CHECKOUT@ --sdnotify=conmon --health-cmd=/usr/local/bin/woow-gateway-health --health-interval=30s --health-timeout=8s --health-start-period=15s --health-retries=3 @IMAGE@
ExecStop=/usr/bin/podman stop --ignore -t 15 woow-tailscale-gateway
ExecStopPost=@CHECKOUT@/scripts/resource_ownership.py reconcile-container @CHECKOUT@
Type=notify
NotifyAccess=all
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
